# SweetCrumbs Bakery — shared environment template
# Copy to .env (root) or portal-specific .env under admin_app/ / delivery_app/ / customer_app/

SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_SECRET_KEY=change-this-to-a-long-random-jwt-secret
FINANCIAL_DATA_ENCRYPTION_KEY=generate-with-python-cryptography-fernet-once-and-reuse
FLASK_ENV=development
PORTAL_ROLE=customer

# --- Local Docker MySQL ---
# docker-compose.yml uses these values for the local MySQL container and all
# app containers. Keep real passwords in your ignored .env file, not in git.
MYSQL_DATABASE=sweetcrumbs_local
MYSQL_USER=local
MYSQL_PASSWORD=replace-with-your-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password
MYSQL_HOST_PORT=3307

# --- Database ---
# Local host-run portals use DATABASE_URL. Docker app containers override this
# and use DB_HOST=mysql so they can reach the MySQL container by service name.
DATABASE_URL=mysql+pymysql://local:replace-with-url-encoded-password@127.0.0.1:3307/sweetcrumbs_local

# Optional local/dev fallback using individual variables.
DB_SCHEME=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=local
DB_PASSWORD=replace-with-your-local-mysql-password
DB_NAME=sweetcrumbs_local
DB_SSL_CA=
DB_SSL_VERIFY_CERT=false
DB_SSL_VERIFY_IDENTITY=false

# --- Redis / realtime / background services (required in production) ---
# For hybrid Render + local admin/delivery, use one shared Redis-compatible
# service. Local admin/delivery should use an external TLS URL such as rediss://.
REDIS_URL=redis://127.0.0.1:6379/0
SOCKETIO_MESSAGE_QUEUE=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# --- Cloudinary storage (required in production) ---
# Render sets STORAGE_REQUIRED=true, so these values must be configured before
# product/category image uploads are enabled in production.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=bakery/products

# --- Portal URLs ---
CUSTOMER_PORTAL_URL=https://bakery-customer-portal.onrender.com
ADMIN_PORTAL_URL=http://127.0.0.1:5001
DELIVERY_PORTAL_URL=http://127.0.0.1:5002

# --- Store GST billing ---
# Use the real 15-digit GSTIN only after registration is complete.
STORE_GSTIN=
GST_RESTAURANT_SERVICE_NO_ITC=true
GST_ECOMMERCE_TCS_RATE=1

# --- Offline sync (admin / delivery local portals only) ---
OFFLINE_SYNC_ENABLED=false
ENABLE_LOCAL_SYNC_WORKER=true

# --- Optional integrations ---
# WHATSAPP_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# GOOGLE_MAPS_API_KEY=
# FCM_ENABLED=false
# FIREBASE_CREDENTIALS_JSON=
# SENTRY_DSN=

# --- Local AI assistant (Ollama on your laptop) ---
# Local development can use Ollama directly. Keep these disabled on Render
# unless you later host a private model endpoint reachable from Render.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=3
AI_ASSISTANT_ENABLED=true
AI_SUPPORT_BOT_ENABLED=true
AI_PUSH_RECOMMENDATIONS_ENABLED=true

# --- Deploy / bootstrap ---
PYTHON_VERSION=3.11.9
BOOTSTRAP_SEED_DATA=false
SHOW_DEMO_ACCOUNTS=false
DEVELOPMENT_CREDENTIALS_ENABLED=false
AUTO_INIT_DB=false
STORAGE_REQUIRED=false
SOCKETIO_ASYNC_MODE=gevent
